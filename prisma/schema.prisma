// Prisma schema for AI University Planner
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          UserRole  @default(STUDENT)
  emailVerified DateTime?
  university    String?
  department    String?
  semester      String?
  cgpa          Float?
  targetCgpa    Float?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  courses            Course[]
  assignments        Assignment[]
  exams              Exam[]
  studyPlans         StudyPlan[]
  notifications      Notification[]
  timetables         Timetable[]
  studyMaterials     StudyMaterial[]
  studyGoals         StudyGoal[]
  copilotConversations CopilotConversation[]
  placementProfile    PlacementProfile?
  applications        PlacementApplication[]
  interviews          Interview[]
  aptitudeResults     AptitudeResult[]
  aptitudeStats       AptitudeStats?
  aptitudeSessions    AptitudeTestSession[]
  roadmapTasks        PlacementRoadmapTask[]
  streak              PlacementStreak?
  organization        Organization?
  accounts           Account[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  hostedMeetings     Meeting[]
  meetingParticipations MeetingParticipant[]
  meetingMessages    MeetingMessage[]
  meetingAttendances MeetingAttendance[]
  meetingRecordings  MeetingRecording[]
  meetingTranscripts MeetingTranscript[]
  meetingNotes       MeetingNote[]
  meetingActionItemsAssigned MeetingActionItem[] @relation("MeetingActionAssignee")
  meetingActionItemsCreated  MeetingActionItem[] @relation("MeetingActionCreator")
  meetingReactions   MeetingReaction[]
  meetingRaisedHands MeetingRaisedHand[]
}

enum UserRole {
  STUDENT
  ORGANIZATION
  ADMIN
}

enum MeetingStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum MeetingType {
  PLACEMENT
  MOCK_INTERVIEW
  GROUP_DISCUSSION
  MENTORSHIP
}

enum MeetingParticipantRole {
  HOST
  CO_HOST
  STUDENT
  GUEST
}

model Meeting {
  id String @id @default(cuid())
  meetingCode String @unique
  roomName String @unique
  title String
  description String?
  hostId String
  passwordHash String
  status MeetingStatus @default(SCHEDULED)
  maxParticipants Int @default(25)
  waitingRoomEnabled Boolean @default(true)
  screenShareEnabled Boolean @default(true)
  chatEnabled Boolean @default(true)
  recordingEnabled Boolean @default(false)
  type MeetingType @default(PLACEMENT)
  scheduledAt DateTime?
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)
  participants MeetingParticipant[]
  sessions MeetingSession[]
  messages MeetingMessage[]
  attendances MeetingAttendance[]
  recordings MeetingRecording[]
  transcripts MeetingTranscript[]
  notes MeetingNote[]
  actionItems MeetingActionItem[]
  reactions MeetingReaction[]
  raisedHands MeetingRaisedHand[]
  @@index([hostId, status])
  @@index([status, scheduledAt])
}

model MeetingParticipant {
  id String @id @default(cuid())
  meetingId String
  userId String
  participantIdentity String
  displayName String
  role MeetingParticipantRole @default(STUDENT)
  joinedAt DateTime?
  leftAt DateTime?
  cameraEnabled Boolean @default(false)
  microphoneEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([meetingId, userId])
  @@unique([meetingId, participantIdentity])
  @@index([meetingId, joinedAt])
}

model MeetingSession {
  id String @id @default(cuid())
  meetingId String
  startedAt DateTime @default(now())
  endedAt DateTime?
  createdAt DateTime @default(now())
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  @@index([meetingId, startedAt])
}

model MeetingMessage {
  id String @id @default(cuid())
  meetingId String
  senderId String
  content String @db.Text
  createdAt DateTime @default(now())
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([meetingId, createdAt])
}

model MeetingAttendance {
  id String @id @default(cuid())
  meetingId String
  userId String
  participantIdentity String
  joinedAt DateTime
  leftAt DateTime?
  duration Int?
  status String @default("PRESENT")
  createdAt DateTime @default(now())
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([meetingId, joinedAt])
  @@index([userId, joinedAt])
}

model MeetingRecording {
  id String @id @default(cuid())
  meetingId String
  createdById String
  storageKey String
  status String @default("PROCESSING")
  duration Int?
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  @@index([meetingId, createdAt])
}

model MeetingTranscript {
  id String @id @default(cuid())
  meetingId String
  speakerId String?
  content String @db.Text
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  speaker User? @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  @@index([meetingId, createdAt])
}

model MeetingNote {
  id String @id @default(cuid())
  meetingId String
  authorId String
  content String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([meetingId, updatedAt])
}

model MeetingActionItem {
  id String @id @default(cuid())
  meetingId String
  assigneeId String?
  createdById String
  title String
  status String @default("OPEN")
  dueAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee User? @relation("MeetingActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User @relation("MeetingActionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  @@index([meetingId, status])
}

model MeetingReaction {
  id String @id @default(cuid())
  meetingId String
  userId String
  participantIdentity String
  reaction String
  createdAt DateTime @default(now())
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([meetingId, createdAt])
}

model MeetingRaisedHand {
  id String @id @default(cuid())
  meetingId String
  userId String
  participantIdentity String
  isRaised Boolean @default(true)
  raisedAt DateTime @default(now())
  loweredAt DateTime?
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([meetingId, userId])
  @@index([meetingId, isRaised, raisedAt])
}

model PlacementProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  branch          String?
  skills          String[] @default([])
  projects        Int      @default(0)
  internships     Int      @default(0)
  aptitudeScore   Float?
  interviewScore  Float?
  resumeScore     Float?
  atsScore        Float?
  githubUrl       String?
  linkedinUrl     String?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                   String                       @id @default(cuid())
  userId               String                       @unique
  companyName          String
  description          String?
  website              String?
  industry             String?
  phone                String?
  location             String?
  companySize          String?
  recruiterName        String?
  recruiterDesignation String?
  verificationStatus   OrganizationVerificationStatus @default(PENDING)
  verificationMessage  String?
  verified             Boolean                      @default(false)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @default(now()) @updatedAt
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs                 PlacementJob[]
  interviews           Interview[]
}

enum OrganizationVerificationStatus {
  PENDING
  APPROVED
  VERIFIED
  REJECTED
  SUSPENDED
}

model PlacementJob {
  id                  String   @id @default(cuid())
  organizationId      String
  title               String
  recruitmentTitle    String?
  jobCode             String?
  department          String?
  description         String
  jobSummary          String?
  requiredSkills      String[] @default([])
  preferredSkills     String[] @default([])
  employmentType      String?
  workMode            String?
  location            String?
  jobType             String?
  salaryRange         String?
  minCgpa             Float?
  maxCgpa             Float?
  openings            Int      @default(1)
  applicationStartDate DateTime?
  experienceLevel     String   @default("Entry")
  applicationDeadline DateTime?
  expectedJoiningDate DateTime?
  eligibility         Json?
  benefits            Json?
  recruitmentRounds   Json?
  applicationForm     Json?
  status              String   @default("PUBLISHED")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications        PlacementApplication[]
  interviews          Interview[]
  @@index([organizationId])
  @@index([isActive])
}

enum PlacementApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  APTITUDE
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

model PlacementApplication {
  id          String   @id @default(cuid())
  studentId   String
  jobId       String
  status      PlacementApplicationStatus @default(APPLIED)
  nextStep    String?
  formData    Json?
  interviewAt DateTime?
  appliedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job         PlacementJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews  Interview[]
  @@unique([studentId, jobId])
  @@index([studentId, status])
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewMode {
  ONLINE
  OFFLINE
  HYBRID
}

model Interview {
  id                    String                @id @default(cuid())
  applicationId         String
  organizationId        String
  studentId             String
  jobId                 String
  title                 String
  round                 String
  status                InterviewStatus       @default(SCHEDULED)
  scheduledDate         DateTime
  startTime             String
  endTime               String
  timezone              String               @default("UTC")
  mode                  InterviewMode         @default(ONLINE)
  platform              String?
  meetingLink           String?
  meetingId             String?
  meetingPassword       String?
  venueName             String?
  venueAddress          String?
  venueRoom             String?
  interviewerName       String?
  interviewerDesignation String?
  interviewerEmail      String?
  interviewerPhone      String?
  instructions          String?
  documentsRequired     String?
  notes                 String?
  cancellationReason    String?
  rescheduleReason      String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  application           PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student               User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job                   PlacementJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId, scheduledDate])
  @@index([studentId, scheduledDate])
  @@index([applicationId])
}

model AptitudeResult {
  id             String   @id @default(cuid())
  userId         String
  testId         String
  category       String?
  score          Float
  totalQuestions Int?
  takenAt        DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test           AptitudeTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  @@index([userId, takenAt])
  @@index([testId])
}

model PlacementStreak {
  userId        String   @id
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  totalXp       Int      @default(0)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlacementRoadmapTask {
  id              String   @id @default(cuid())
  userId          String
  phaseId         String
  taskKey         String
  title           String
  description     String
  priority        String   @default("MEDIUM")
  status          String   @default("PENDING")
  estimatedMinutes Int     @default(30)
  dueDate         DateTime?
  notes           String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskKey])
  @@index([userId, phaseId])
  @@index([userId, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  tokenType String   @default("EMAIL_VERIFICATION")
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CopilotConversation {
  id        String          @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CopilotMessage[]

  @@index([userId])
  @@index([updatedAt])
}

model CopilotMessage {
  id             String               @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime             @default(now())

  conversation   CopilotConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Course {
  id            String   @id @default(cuid())
  userId        String
  courseName    String
  courseCode    String
  creditHours   Int
  instructor    String?
  semester      String?
  currentGrade  String?
  createdAt     DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   Assignment[]
  exams         Exam[]

  @@index([userId])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Assignment {
  id              String            @id @default(cuid())
  userId          String
  courseId        String
  title           String
  description     String?
  deadline        DateTime
  difficulty      Difficulty        @default(MEDIUM)
  estimatedHours  Float             @default(1)
  status          AssignmentStatus  @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

model Exam {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  examType   String
  date       DateTime
  time       String
  location   String?
  notes      String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

model StudyPlan {
  id           String   @id @default(cuid())
  userId       String
  plan         Json
  generatedAt  DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationType {
  ASSIGNMENT_DUE
  EXAM_SOON
  TASK_COMPLETED
  MISSED_DEADLINE
  STUDY_PLAN_GENERATED
  TIMETABLE_CREATED
  MATERIAL_ADDED
  MATERIAL_UPDATED
  MATERIAL_RESTORED
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  INTERVIEW_RESCHEDULED
  INTERVIEW_CANCELLED
}

enum TimetableStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum SessionType {
  LECTURE
  REVISION
  PRACTICE
  ASSIGNMENT
  PRACTICAL
  PROJECT
  READING
  EXAM_PREPARATION
  MOCK_TEST
  BREAK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Timetable {
  id                String          @id @default(cuid())
  userId            String
  subjectName       String
  date              DateTime
  startTime         String
  endTime           String
  sessionType       SessionType     @default(LECTURE)
  priority          Priority        @default(MEDIUM)
  totalLectures     Int             @default(1)
  completedLectures Int             @default(0)
  pendingWork       String?
  notes             String?
  status            TimetableStatus @default(PENDING)
  isBreak           Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([status])
}

model StudyGoal {
  id              String          @id @default(cuid())
  userId          String
  goalType        String          @default("DAILY") // DAILY or WEEKLY
  targetHours     Float           @default(6)
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([goalType])
}

model Notification {
  id         String            @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType
  isRead     Boolean           @default(false)
  createdAt  DateTime          @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MaterialType {
  NOTES
  PDF
  IMAGE
  DOCUMENT
  LINK
}

model StudyMaterial {
  id            String       @id @default(cuid())
  userId        String
  materialName  String
  subject       String
  unit          String
  type          MaterialType
  description   String?
  notesContent  String?
  fileUrl       String?
  resourceUrl   String?
  tags          String[]     @default([])
  isImportant   Boolean      @default(false)
  isFavorite    Boolean      @default(false)
  isDeleted     Boolean      @default(false)
  lastViewedAt  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subject])
  @@index([unit])
  @@index([type])
  @@index([isDeleted])
}

// ========== APTITUDE TEST SYSTEM ==========

enum AptitudeDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  NUMERIC
  TRUE_FALSE
  ASSERTION_REASON
  PASSAGE_BASED
}

enum TestSessionStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

model AptitudeCategory {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?
  icon            String?
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tests           AptitudeTest[]
  questions       AptitudeQuestion[]

  @@index([isActive])
}

model AptitudeTest {
  id                  String   @id @default(cuid())
  categoryId          String
  title               String
  description         String?
  difficulty          AptitudeDifficulty @default(MEDIUM)
  questionCount       Int      @default(20)
  durationMinutes     Int      @default(30)
  correctMarkPerQ     Float    @default(1.0)
  negativeMarkPerQ    Float    @default(0.25)
  shuffleQuestions    Boolean  @default(true)
  shuffleOptions      Boolean  @default(true)
  isActive            Boolean  @default(true)
  isPublished         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  category            AptitudeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions           AptitudeQuestion[]
  sessions            AptitudeTestSession[]
  results             AptitudeResult[]

  @@index([categoryId])
  @@index([isActive, isPublished])
  @@index([difficulty])
}

model AptitudeQuestion {
  id                  String   @id @default(cuid())
  testId              String
  categoryId          String
  questionText        String
  type                QuestionType @default(SINGLE_CHOICE)
  difficulty          AptitudeDifficulty @default(MEDIUM)
  marks               Float    @default(1.0)
  negativeMarks       Float    @default(0.25)
  explanation         String?
  solutionText        String?
  imageUrl            String?
  displayOrder        Int
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  test                AptitudeTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  category            AptitudeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options             AptitudeOption[]
  answers             AptitudeAnswer[]

  @@index([testId])
  @@index([categoryId])
  @@index([difficulty])
  @@index([displayOrder])
}

model AptitudeOption {
  id                  String   @id @default(cuid())
  questionId          String
  optionText          String
  optionLabel         String   // A, B, C, D, etc.
  isCorrect           Boolean  @default(false)
  displayOrder        Int
  createdAt           DateTime @default(now())

  question            AptitudeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@unique([questionId, optionLabel])
}

model AptitudeTestSession {
  id                  String   @id @default(cuid())
  userId              String
  testId              String
  status              TestSessionStatus @default(IN_PROGRESS)
  startedAt           DateTime @default(now())
  completedAt         DateTime?
  expiresAt           DateTime
  currentQuestionNo   Int      @default(1)
  totalQuestions      Int
  correctAnswers      Int      @default(0)
  wrongAnswers        Int      @default(0)
  unansweredCount     Int      @default(0)
  score               Float?
  accuracy            Float?
  timeTakenSeconds    Int?
  isFullscreen        Boolean  @default(false)
  tabSwitchCount      Int      @default(0)
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test                AptitudeTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers             AptitudeAnswer[]

  @@index([userId])
  @@index([testId])
  @@index([status])
  @@index([startedAt])
  @@unique([userId, testId])
}

model AptitudeAnswer {
  id                  String   @id @default(cuid())
  sessionId           String
  questionId          String
  selectedOption      String?  // For MCQ/Multiple choice
  numericAnswer       Float?   // For numeric questions
  isCorrect           Boolean?
  timespentSeconds    Int      @default(0)
  markedForReview     Boolean  @default(false)
  answeredAt          DateTime @default(now())

  session             AptitudeTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question            AptitudeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionId])
  @@unique([sessionId, questionId])
}

model AptitudeStats {
  id                  String   @id @default(cuid())
  userId              String   @unique
  totalTests          Int      @default(0)
  completedTests      Int      @default(0)
  bestScore           Float?
  averageScore        Float?
  averageAccuracy     Float?
  totalQuestionsAttempted Int @default(0)
  totalCorrect        Int      @default(0)
  totalWrong          Int      @default(0)
  currentStreak       Int      @default(0)
  longestStreak       Int      @default(0)
  totalTimeSeconds    Int      @default(0)
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
