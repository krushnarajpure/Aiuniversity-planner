// Prisma schema for AI University Planner
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          UserRole  @default(STUDENT)
  emailVerified DateTime?
  university    String?
  department    String?
  semester      String?
  cgpa          Float?
  targetCgpa    Float?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  courses            Course[]
  assignments        Assignment[]
  exams              Exam[]
  studyPlans         StudyPlan[]
  notifications      Notification[]
  timetables         Timetable[]
  studyMaterials     StudyMaterial[]
  studyGoals         StudyGoal[]
  copilotConversations CopilotConversation[]
  accounts           Account[]
  sessions           Session[]
  verificationTokens VerificationToken[]
}

enum UserRole {
  STUDENT
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  tokenType String   @default("EMAIL_VERIFICATION")
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CopilotConversation {
  id        String          @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CopilotMessage[]

  @@index([userId])
  @@index([updatedAt])
}

model CopilotMessage {
  id             String               @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime             @default(now())

  conversation   CopilotConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Course {
  id            String   @id @default(cuid())
  userId        String
  courseName    String
  courseCode    String
  creditHours   Int
  instructor    String?
  semester      String?
  currentGrade  String?
  createdAt     DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   Assignment[]
  exams         Exam[]

  @@index([userId])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Assignment {
  id              String            @id @default(cuid())
  userId          String
  courseId        String
  title           String
  description     String?
  deadline        DateTime
  difficulty      Difficulty        @default(MEDIUM)
  estimatedHours  Float             @default(1)
  status          AssignmentStatus  @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

model Exam {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  examType   String
  date       DateTime
  time       String
  location   String?
  notes      String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

model StudyPlan {
  id           String   @id @default(cuid())
  userId       String
  plan         Json
  generatedAt  DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationType {
  ASSIGNMENT_DUE
  EXAM_SOON
  TASK_COMPLETED
  MISSED_DEADLINE
  STUDY_PLAN_GENERATED
  TIMETABLE_CREATED
  MATERIAL_ADDED
  MATERIAL_UPDATED
  MATERIAL_RESTORED
}

enum TimetableStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum SessionType {
  LECTURE
  REVISION
  PRACTICE
  ASSIGNMENT
  PRACTICAL
  PROJECT
  READING
  EXAM_PREPARATION
  MOCK_TEST
  BREAK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Timetable {
  id                String          @id @default(cuid())
  userId            String
  subjectName       String
  date              DateTime
  startTime         String
  endTime           String
  sessionType       SessionType     @default(LECTURE)
  priority          Priority        @default(MEDIUM)
  totalLectures     Int             @default(1)
  completedLectures Int             @default(0)
  pendingWork       String?
  notes             String?
  status            TimetableStatus @default(PENDING)
  isBreak           Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([status])
}

model StudyGoal {
  id              String          @id @default(cuid())
  userId          String
  goalType        String          @default("DAILY") // DAILY or WEEKLY
  targetHours     Float           @default(6)
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([goalType])
}

model Notification {
  id         String            @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType
  isRead     Boolean           @default(false)
  createdAt  DateTime          @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MaterialType {
  NOTES
  PDF
  IMAGE
  DOCUMENT
  LINK
}

model StudyMaterial {
  id            String       @id @default(cuid())
  userId        String
  materialName  String
  subject       String
  unit          String
  type          MaterialType
  description   String?
  notesContent  String?
  fileUrl       String?
  resourceUrl   String?
  tags          String[]     @default([])
  isImportant   Boolean      @default(false)
  isFavorite    Boolean      @default(false)
  isDeleted     Boolean      @default(false)
  lastViewedAt  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subject])
  @@index([unit])
  @@index([type])
  @@index([isDeleted])
}
