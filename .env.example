# --- Database (from Supabase Project Settings > Database) ---
# Use the "Connection Pooling" URL for DATABASE_URL (port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Use the "Direct Connection" URL for DIRECT_URL (port 5432) — needed for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres"

# --- Auth.js (NextAuth) ---
# Production: https://your-project.vercel.app (use http://localhost:3000 locally)
NEXTAUTH_URL="https://your-project.vercel.app"
# Public URL used for OAuth callback redirects
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="YOUR_BREVO_SMTP_USERNAME"
SMTP_PASSWORD="YOUR_BREVO_SMTP_KEY"
SMTP_FROM="YOUR_VERIFIED_SENDER_EMAIL"

# --- AI Study Planner (Groq API — free tier) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=""
# Optional; defaults to openai/gpt-oss-20b.
GROQ_MODEL="openai/gpt-oss-20b"