# --- Database (from Supabase Project Settings > Database) ---
# Use the "Connection Pooling" URL for DATABASE_URL (port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Use the "Direct Connection" URL for DIRECT_URL (port 5432) — needed for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres"

# --- Auth.js (NextAuth) ---
NEXTAUTH_URL="http://localhost:3001"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Password reset and verification email settings.
# For Gmail, enable 2-Step Verification and create a Google App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASSWORD="your-16-character-gmail-app-password"
SMTP_FROM="your-gmail@gmail.com"
# Alternatively use GMAIL_USER and GMAIL_APP_PASSWORD; Gmail host/port are inferred.

# --- AI Assistant (Gemini preferred; Groq fallback) ---
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional; defaults to gemini-2.5-flash.
GEMINI_MODEL="gemini-2.5-flash"
# Optional Avishu Live bridge. Keep the token secret server-side and run `npm run avishu:live` separately.
AVISHU_LIVE_TOKEN_SECRET=""
AVISHU_LIVE_WS_URL="ws://localhost:8787/live"
AVISHU_LIVE_PORT="8787"
AVISHU_GEMINI_MODEL="gemini-2.5-flash-native-audio-latest"
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=""
# Optional; defaults to llama-3.1-8b-instant.
GROQ_MODEL="llama-3.1-8b-instant"

# --- LiveKit Cloud or self-hosted LiveKit server ---
LIVEKIT_URL="wss://your-livekit-host"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"